<Window x:Class="Laba1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Laba1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TabControl x:Name="myTabControl" FontSize="20">
            <TabItem Header="Laba1">
                <Grid>
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="Gray" Height="15" BorderBrush="Black" BorderThickness="0.5" />
                        <Border DockPanel.Dock="Top" Background="Gray" Height="20" BorderBrush="Black" BorderThickness="0.1" />

                        <DockPanel DockPanel.Dock="Left">
                            <Border DockPanel.Dock="Right" Background="DarkGray" Width="60" BorderBrush="Black" BorderThickness="2" />
                            <Button x:Name="SmallButton" DockPanel.Dock="Bottom" Content="" Background="DarkGray" Width="15" Click="SmallButtonClick" />
                        </DockPanel>
                        <Border DockPanel.Dock="Right" Background="DarkGray" Width="150" BorderBrush="Black" BorderThickness="2" />
                        <Border DockPanel.Dock="Bottom" Background="DarkGray" Height="45"  BorderBrush="Black" BorderThickness="2" />
                        <Grid DockPanel.Dock="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" Background="LightGray" BorderBrush="Black" BorderThickness="2" />
                        </Grid>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>